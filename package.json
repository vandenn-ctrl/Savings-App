{
  "name": "family-savings-app",
  "version": "1.0.0",
  "private": true,
  "description": "A family savings & investment tracker built on Google Sheets + Google Apps Script.",
  "scripts": {
    "login": "clasp login --no-localhost",
    "create": "clasp create --type sheets --title \"Family Savings App\" --rootDir ./src",
    "push": "clasp push",
    "open": "clasp open",
    "deploy": "clasp deploy"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2"
  }
}
